{
  "name": "picnest",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The asset router answers browser *navigations* before the Worker runs, so
    // without this a pasted /f/ link or an opened /s/ share would get index.html
    // instead of the image. These prefixes must always reach the Worker.
    "run_worker_first": ["/api/*", "/f/*", "/s/*"],
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "picnest",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "picnest",
      // The Deploy to Cloudflare flow replaces this with the database selected
      // for the cloned repository. Local dev uses SQLite and ignores this id.
      "database_id": "75185edc-8a4e-4682-8a4d-b9d4f68f1532",
      "migrations_dir": "migrations",
    },
  ],
  // Declaration only — values live in `.dev.vars` locally and in the secret
  // store in production. Missing one fails `wrangler deploy` outright, which
  // beats deploying fine and only breaking at the first login attempt.
  // JWT_SECRET must be random bytes, not a password you chose: it is an HMAC
  // key, and a guessable one turns any captured session token into an offline
  // dictionary attack (RFC 8725 §3.5).
  "secrets": {
    "required": ["ADMIN_PASSWORD", "JWT_SECRET"],
  },
  // Both limiters guard a single short secret typed by a human, which is the
  // only thing standing between a guesser and the content behind it. This is
  // the platform's own rate limiter (per colo, no storage, no billing);
  // `namespace_id` is a local label and `period` accepts only 10 or 60.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      // Keyed by IP *and* share token, so guessing at one link never locks a
      // visitor out of another.
      "name": "SHARE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
